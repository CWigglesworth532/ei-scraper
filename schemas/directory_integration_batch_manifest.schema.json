{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skopia:sko-024:directory-integration-batch-manifest:v1",
  "title": "SKO-024 no-write directory integration batch manifest",
  "type": "object",
  "required": ["batch_id", "lifecycle_state", "created_at", "created_by", "proposal_input_hash", "batch_content_hash", "config_version", "input_proposal_count", "actionable_count", "noop_count", "holdout_count", "unique_airtable_record_ids", "unique_entity_id_count", "unique_counting_entity_id_count", "counts_by_relationship_type", "stale_fingerprint_count", "duplicate_count", "conflict_count", "duplicate_crosswalk_key_count", "duplicate_profile_record_id_count", "missing_record_id_count", "identity_gate_blocks", "classification_gate_blocks", "readiness_gate_blocks", "invalid_relationship_type_count", "invalid_counting_entity_id_count", "allowlist_violations", "protected_field_mutation_attempts", "publication_mutation_attempts", "approval_state", "approval_hash_match", "handoff_ready"],
  "properties": {
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "lifecycle_state": {"enum": ["REVIEWABLE_BATCH", "HANDOFF_READY"]},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "proposal_input_hash": {"$ref": "#/$defs/hash"},
    "batch_content_hash": {"$ref": "#/$defs/hash"},
    "config_version": {"type": "string", "minLength": 1},
    "input_proposal_count": {"$ref": "#/$defs/count"},
    "actionable_count": {"$ref": "#/$defs/count"},
    "noop_count": {"$ref": "#/$defs/count"},
    "holdout_count": {"$ref": "#/$defs/count"},
    "unique_airtable_record_ids": {"$ref": "#/$defs/count"},
    "unique_entity_id_count": {"$ref": "#/$defs/count"},
    "unique_counting_entity_id_count": {"$ref": "#/$defs/count"},
    "counts_by_relationship_type": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}},
    "stale_fingerprint_count": {"$ref": "#/$defs/count"},
    "duplicate_count": {"$ref": "#/$defs/count"},
    "conflict_count": {"$ref": "#/$defs/count"},
    "duplicate_crosswalk_key_count": {"$ref": "#/$defs/count"},
    "duplicate_profile_record_id_count": {"$ref": "#/$defs/count"},
    "missing_record_id_count": {"$ref": "#/$defs/count"},
    "identity_gate_blocks": {"$ref": "#/$defs/count"},
    "classification_gate_blocks": {"$ref": "#/$defs/count"},
    "readiness_gate_blocks": {"$ref": "#/$defs/count"},
    "invalid_relationship_type_count": {"$ref": "#/$defs/count"},
    "invalid_counting_entity_id_count": {"$ref": "#/$defs/count"},
    "allowlist_violations": {"$ref": "#/$defs/count"},
    "protected_field_mutation_attempts": {"$ref": "#/$defs/count"},
    "publication_mutation_attempts": {"$ref": "#/$defs/count"},
    "approval_state": {"enum": ["not_approved", "approved"]},
    "approval_hash_match": {"type": "boolean"},
    "handoff_ready": {"type": "boolean"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
