{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skopia.example/schemas/activity_evidence.schema.json",
  "title": "SKO-029 governed activity evidence",
  "type": "object",
  "required": ["activity_evidence_id", "subject_type", "subject_id", "entity_id", "evidence_type", "source_name", "source_record_id", "source_reference", "source_code_field", "source_description_field", "activity_scheme", "activity_version", "activity_code_raw", "activity_description_raw", "is_principal_activity", "evidence_authority", "evidence_status", "source_version", "source_file_sha256", "retrieved_at", "extracted_at", "evidence_fingerprint", "schema_version"],
  "properties": {
    "activity_evidence_id": {"type": "string", "pattern": "^actev_[0-9a-f]{24}$"},
    "subject_type": {"enum": ["canonical_entity", "supplier_observation"]},
    "subject_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string"},
    "evidence_type": {"enum": ["official_activity_code", "official_activity_description", "official_company_description", "procurement_category", "directory_sector", "directory_business_summary", "other_activity_text"]},
    "source_name": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "source_reference": {"type": "string", "minLength": 1},
    "source_code_field": {"type": "string"},
    "source_description_field": {"type": "string"},
    "activity_scheme": {"enum": ["", "CNAE", "CCAE", "NACE", "other"]},
    "activity_version": {"type": "string"},
    "activity_code_raw": {"type": "string"},
    "activity_description_raw": {"type": "string"},
    "is_principal_activity": {"enum": ["true", "false", "unknown"]},
    "evidence_authority": {"enum": ["authoritative", "strong", "supporting", "contextual", "weak"]},
    "evidence_status": {"enum": ["usable", "review_required", "ambiguous", "insufficient_evidence", "unsupported"]},
    "source_version": {"type": "string", "minLength": 1},
    "source_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "extracted_at": {"type": "string", "format": "date-time"},
    "evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "sko-029-activity-evidence-v1"}
  },
  "allOf": [{"if": {"properties": {"subject_type": {"const": "canonical_entity"}}}, "then": {"properties": {"entity_id": {"minLength": 1}}}}],
  "additionalProperties": false
}
