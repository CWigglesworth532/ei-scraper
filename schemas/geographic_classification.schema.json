{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skopia.example/schemas/geographic_classification.schema.json",
  "title": "SKO-027 governed geographic classification row",
  "type": "object",
  "required": ["classification_id", "subject_type", "subject_id", "entity_id", "country", "postcode", "city", "address", "location_role", "geography_scheme", "geography_version", "geography_level", "geography_code", "geography_name", "mapping_status", "mapping_method", "mapping_source", "mapping_source_version", "mapping_source_sha256", "mapping_evidence", "mapping_confidence", "input_fingerprint", "classifier_version", "classified_at"],
  "properties": {
    "classification_id": {"type": "string", "pattern": "^geo_[0-9a-f]{24}$"},
    "subject_type": {"enum": ["canonical_entity", "supplier_observation"]},
    "subject_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string"},
    "country": {"type": "string"},
    "postcode": {"type": "string"},
    "city": {"type": "string"},
    "address": {"type": "string"},
    "location_role": {"enum": ["registered_or_hq", "contracted_activity", "unknown"]},
    "geography_scheme": {"enum": ["", "NUTS", "ITL"]},
    "geography_version": {"type": "string"},
    "geography_level": {"enum": ["", "1", "2", "3"]},
    "geography_code": {"type": "string"},
    "geography_name": {"type": "string"},
    "mapping_status": {"enum": ["resolved", "ambiguous", "insufficient_evidence", "unsupported_country"]},
    "mapping_method": {"const": "postcode_correspondence"},
    "mapping_source": {"type": "string", "minLength": 1},
    "mapping_source_version": {"type": "string", "minLength": 1},
    "mapping_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapping_evidence": {"type": "string", "minLength": 1},
    "mapping_confidence": {"enum": ["strong", "none"]},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classifier_version": {"const": "sko-027-statistical-geography-v1"},
    "classified_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
