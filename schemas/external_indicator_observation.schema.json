{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skopia.example/schemas/external_indicator_observation.schema.json",
  "title": "SKO-028 normalized external indicator observation",
  "type": "object",
  "required": ["observation_id", "source_id", "source_name", "dataset_id", "dataset_title", "dataset_version", "indicator_id", "indicator_name", "indicator_description", "indicator_theme", "geography_scheme", "geography_version", "geography_level", "geography_code", "period", "period_type", "value", "unit", "value_status", "source_version", "source_reference", "retrieved_at", "transformation_method", "transformation_version", "input_file_sha256", "ingestion_version", "observation_fingerprint"],
  "properties": {
    "observation_id": {"type": "string", "pattern": "^obs_[0-9a-f]{24}$"},
    "source_id": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_title": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "indicator_id": {"type": "string", "minLength": 1},
    "indicator_name": {"type": "string", "minLength": 1},
    "indicator_description": {"type": "string"},
    "indicator_theme": {"enum": ["socioeconomic", "environmental"]},
    "geography_scheme": {"enum": ["NUTS", "ITL"]},
    "geography_version": {"type": "string", "minLength": 1},
    "geography_level": {"enum": ["1", "2", "3"]},
    "geography_code": {"type": "string", "minLength": 1},
    "period": {"type": "string", "minLength": 1},
    "period_type": {"type": "string", "minLength": 1},
    "value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "unit": {"type": "string", "minLength": 1},
    "value_status": {"type": "string"},
    "source_version": {"type": "string", "minLength": 1},
    "source_reference": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "transformation_method": {"const": "configured_local_csv_extract"},
    "transformation_version": {"type": "string", "minLength": 1},
    "input_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ingestion_version": {"const": "sko-028-external-indicators-v1"},
    "observation_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
