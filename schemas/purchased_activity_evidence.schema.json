{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SKO-035 purchased activity evidence",
    "type": "object",
    "required": [
        "purchased_activity_evidence_id",
        "subject_type",
        "subject_id",
        "evidence_type",
        "evidence_reference",
        "evidence_date",
        "activity_scheme",
        "activity_version",
        "activity_code_raw",
        "activity_description_raw",
        "evidence_authority",
        "evidence_fingerprint",
        "schema_version"
    ],
    "properties": {
        "purchased_activity_evidence_id": {
            "type": "string",
            "pattern": "^paev_[0-9a-f]{24}$"
        },
        "subject_type": {
            "enum": [
                "canonical_entity",
                "supplier_observation"
            ]
        },
        "subject_id": {
            "type": "string",
            "minLength": 1
        },
        "evidence_type": {
            "enum": [
                "contract_service",
                "supplier_service_line",
                "official_activity",
                "other_business_activity",
                "procurement_category",
                "broad_inference"
            ]
        },
        "evidence_reference": {
            "type": "string",
            "minLength": 1
        },
        "evidence_date": {
            "type": "string",
            "format": "date"
        },
        "activity_scheme": {
            "type": "string"
        },
        "activity_version": {
            "type": "string"
        },
        "activity_code_raw": {
            "type": "string"
        },
        "activity_description_raw": {
            "type": "string"
        },
        "evidence_authority": {
            "enum": [
                "authoritative",
                "strong",
                "contextual",
                "weak"
            ]
        },
        "evidence_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
            "const": "sko-035-purchased-activity-evidence-v1"
        }
    },
    "additionalProperties": false
}
